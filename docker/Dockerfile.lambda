# FastAPI on Lambda via the AWS Lambda Web Adapter, which translates Lambda
# invocations into ordinary HTTP against the app -- so the same image also runs
# under plain `docker run` for local testing.
#
# Build from the repo root, with the weights fetched first:
#   uv run python -m road_defect.registry fetch --dest artifacts
#   docker build --platform linux/amd64 -f docker/Dockerfile.lambda -t road-defect .

FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.24 /uv /usr/local/bin/uv

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

COPY pyproject.toml uv.lock README.md ./
COPY src ./src

# uv.lock pins CPU-only torch for linux (see [tool.uv.sources] in pyproject),
# which keeps this image at a fraction of the CUDA build's size.
RUN uv sync --locked --no-dev


FROM python:3.12-slim

# opencv-python is a hard ultralytics dependency and links against these.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 /lambda-adapter /opt/extensions/lambda-adapter

WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src /app/src
COPY artifacts/best.pt /app/model/best.pt

# Only /tmp is writable on Lambda, and ultralytics/matplotlib both want a
# config directory at import time.
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app/src \
    MODEL_WEIGHTS=/app/model/best.pt \
    YOLO_CONFIG_DIR=/tmp \
    MPLCONFIGDIR=/tmp \
    HOME=/tmp \
    PORT=8080 \
    AWS_LWA_PORT=8080

EXPOSE 8080
CMD ["uvicorn", "road_defect.serving.app:app", "--host", "0.0.0.0", "--port", "8080"]
