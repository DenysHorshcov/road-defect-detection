# Copy to .env and fill in. .env is gitignored.

# Mapillary client access token (starts with "MLY|").
# Register an app at https://www.mapillary.com/dashboard/developers
# A client token is enough for read/search; user tokens are only for uploads.
MAPILLARY_TOKEN=

# Local MLflow tracking server (see: mlflow server --port 5000)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=road-defect-v1

# AWS (Phase 7)
AWS_REGION=eu-central-1
ECR_REPOSITORY=road-defect-detection
